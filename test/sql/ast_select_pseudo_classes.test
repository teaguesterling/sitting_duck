# name: test/sql/ast_select_pseudo_classes.test
# group: [sql]

# Test ast_select pseudo-classes: positional, structural, scope, ordering

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# Standard CSS positional pseudo-classes
# =============================================================================

# :first-child — first sibling (sibling_index = 0)
# The nested `inner` functions are the only function_definitions at sibling_index 0
query II
SELECT name, depth
FROM ast_select('test/data/python/macros/recursive_match.py', 'function_definition:first-child')
ORDER BY start_line;
----
inner	3
inner	3

# :last-child — last sibling at depth 1
query II
SELECT name, start_line
FROM ast_select('test/data/python/macros/recursive_match.py', 'function_definition:last-child')
WHERE depth = 1;
----
outer_no_execute	37

# :nth-child(2) — second sibling (1-based) at depth 1
# shallow_return is sibling_index 1 (comment is 0), so nth-child(2)
query II
SELECT name, start_line
FROM ast_select('test/data/python/macros/recursive_match.py', 'function_definition:nth-child(2)')
WHERE depth = 1;
----
shallow_return	2

# :empty — nodes with no children
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/python/macros/recursive_match.py', ':empty');
----
true

# :root — depth = 0
query I
SELECT type FROM ast_select('test/data/python/macros/recursive_match.py', ':root');
----
module

# =============================================================================
# Custom structural pseudo-classes
# =============================================================================

# :named — has a non-empty name
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py', 'function_definition:named');
----
10

# :syntax — syntax-only tokens (keywords, punctuation)
# Bare `if` matches both keyword and statement; if:syntax gets only keywords
query I
SELECT COUNT(DISTINCT type)
FROM ast_select('test/data/python/macros/recursive_match.py', 'if:syntax');
----
1

# :definition — NAME_DEFINITION flag
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:definition');
----
10

# :reference — NAME_REFERENCE flag
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/python/macros/recursive_match.py',
    'identifier:reference');
----
true

# =============================================================================
# :scope — the node IS a scope boundary (identity, CSS-consistent). Kind/name
# filters narrow WHICH scope. Containment ("things inside a scope") is :in-scope.
# =============================================================================

# :scope (bare) — nodes that are themselves scope boundaries
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:scope');
----
10

# :scope(function|class|module) — a scope OF that semantic kind (not its contents)
query III
SELECT
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(function)')),
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(class)')),
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(module)'));
----
6	3	1

# Bare :scope = the three kinds together (function 6 + class 3 + module 1 = 10)
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope');
----
10

# :scope(<tree-sitter type>) — a scope of exactly that node type
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(function_definition)');
----
6

# .class shape and its aliases resolve the same as the keyword
query I
SELECT
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.fn)'))
      = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(function)'))
AND (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.func)'))
      = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.fn)'))
AND (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.cls)'))
      = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.class)'))
AND (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.module)'))
      = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.mod)'));
----
true

# :scope(.fn#foo) — the ONE scope boundary named foo
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.fn#top_level_function)')
WHERE name = 'top_level_function';
----
1

# =============================================================================
# :in-scope — the node is CONTAINED WITHIN a scope. function/class/module use
# the precomputed scope.* struct; a bare tree-sitter type walks to the nearest
# enclosing ancestor of that type.
# =============================================================================

# :in-scope(function|class|module) — everything contained in a scope of that kind
query III
SELECT
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(function)')),
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(class)')),
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(module)'));
----
107	99	132

# The struct fast-path (:in-scope(function)) and the bare-type ancestor walk
# (:in-scope(function_definition)) agree — function_definition is the only fn scope.
query I
SELECT
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(function)'))
  = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(function_definition)'));
----
true

# Bare-type ancestor walk excludes nested-function returns from the outer function
# (was :scope(function_definition) before the :scope/:in-scope split).
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'return_statement:in-scope(function_definition)');
----
5

# :in-scope(.fn#foo) — the workhorse: everything inside the named function's scope
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(.fn#top_level_function)');
----
15

# keyword vs .class#name equivalence for containment
query I
SELECT
    (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(.func#top_level_function)'))
  = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(.fn#top_level_function)'));
----
true

# Self-exclusion: the scope NODE (the function_definition) is not "in the scope of"
# itself. Its own name identifier and body ARE in scope — only the boundary is out.
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(.fn#top_level_function)')
WHERE type = 'function_definition' AND name = 'top_level_function';
----
0

# Compound: functions whose nearest enclosing class is User (__init__, validate)
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', '.fn:in-scope(.class#User)');
----
2

# =============================================================================
# :scope / :in-scope argument guards — loud errors, never silent-wrong results
# =============================================================================

# An arbitrary semantic scope is Tier 2 (#145), not a silent empty result
statement error
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.loop)');
----
issue #145

# Bare :in-scope needs an argument
statement error
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope');
----
requires an argument

# #name on the keyword form is rejected (grammar can't split function#foo) — use .fn#foo
statement error
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(function#top_level_function)');
----
semantic-class form

statement error
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':in-scope(function#top_level_function)');
----
semantic-class form

# =============================================================================
# :precedes(type) and :follows(type)
# =============================================================================

# :precedes(function_definition) — comments that come before a function def
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'comment:precedes(function_definition)');
----
3

# :follows(class_definition) — functions defined after a class
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/python/qualified_names.py',
    'function_definition:follows(class_definition)');
----
true

# =============================================================================
# Compound pseudo-classes
# =============================================================================

# :named:definition — named definitions only
# #64: named definitions = 10 function definitions + 8 bare parameters + 1 for-loop
# target (the `i` at line 12) — all NAME_DEFINITION now.
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    ':named:definition');
----
19

# function_definition:first-child:has(return_statement) — first-child functions with returns
# The inner functions are first-child and have no returns themselves
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:first-child:has(return_statement)');
----
0

# =============================================================================
# :not(:pseudo-class) — negation of arbitrary pseudo-classes
# =============================================================================

# The :is-called / :not(:is-called) pair should partition the set of functions
# exactly: every function is either called or not, never both, never neither.
query III
WITH t AS (
    SELECT COUNT(*) FILTER (WHERE true) AS total,
           COUNT(*) FILTER (WHERE is_called) AS called,
           COUNT(*) FILTER (WHERE NOT is_called) AS not_called
    FROM (
        SELECT name,
               EXISTS (
                   SELECT 1 FROM ast_select('test/data/python/sample_app.py', '.func:is-called') c
                   WHERE c.node_id = f.node_id
               ) AS is_called
        FROM ast_select('test/data/python/sample_app.py', '.func') f
    )
)
SELECT total, called, not_called FROM t;
----
20	13	7

# :not(:is-called) should return exactly the functions that :is-called doesn't
query I
SELECT COUNT(*) FROM ast_select('test/data/python/sample_app.py', '.func:not(:is-called)');
----
7

# :not(:is-referenced) partitions the function set with :is-referenced
# (In sample_app.py every method is referenced via self.method, so not_ref = 0.)
query II
SELECT
    (SELECT COUNT(*) FROM ast_select('test/data/python/sample_app.py', '.func:is-referenced'))
  + (SELECT COUNT(*) FROM ast_select('test/data/python/sample_app.py', '.func:not(:is-referenced)')),
    (SELECT COUNT(*) FROM ast_select('test/data/python/sample_app.py', '.func'));
----
20	20

# Compound: :exported:not(:is-referenced) — example from the docs
# Uses a data file with unambiguously exported definitions
query I
SELECT COUNT(*) >= 0 FROM ast_select('test/data/python/sample_app.py',
    ':exported:not(:is-referenced)');
----
true

# =============================================================================
# :called-by / :calls — DIRECT (immediate scope.function), lambda-aware
# (#146/#152/#164). A call inside a lambda or nested function belongs to that
# inner scope, not the outer function. Bounded via the precomputed scope.function
# equi-join (replaces the range self-join that OOM'd on large tables, #164).
# Fixture: outer() calls helper(); a lambda `inner` calls helper2(); nested()
# calls helper3().
# =============================================================================

# :called-by(outer) matches ONLY helper — NOT helper2 (that call's immediate
# scope is the lambda, not outer). This is the #152 lambda ruling.
query I
SELECT COUNT(*) FROM ast_select('test/data/python/callgraph_direct.py', '.call:called-by(outer)');
----
1

# The lambda `inner` is helper2's immediate scope, so :called-by(inner) matches it
query I
SELECT COUNT(*) FROM ast_select('test/data/python/callgraph_direct.py', '.call:called-by(inner)');
----
1

# Bare :called-by — every call is inside some function scope (3 calls)
query I
SELECT COUNT(*) FROM ast_select('test/data/python/callgraph_direct.py', '.call:called-by');
----
3

# :calls is direct too: outer directly calls helper …
query I
SELECT COUNT(*) FROM ast_select('test/data/python/callgraph_direct.py', 'function_definition#outer:calls(helper)');
----
1

# … but NOT helper2 — that call belongs to the lambda, not outer
query I
SELECT COUNT(*) FROM ast_select('test/data/python/callgraph_direct.py', 'function_definition#outer:calls(helper2)');
----
0

# nested() directly calls helper3
query I
SELECT COUNT(*) FROM ast_select('test/data/python/callgraph_direct.py', 'function_definition#nested:calls(helper3)');
----
1

# :not() should compose with other pseudo-classes on the same node
# .func:named:not(:is-called) — named functions that are never called
query I
SELECT COUNT(*) FROM ast_select('test/data/python/sample_app.py',
    '.func:named:not(:is-called)');
----
7

# :not(:has()) must still work via the original not_has_conditions path
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/python/sample_app.py',
    '.func:not(:has(return_statement))');
----
true

# =============================================================================
# Unknown pseudo-classes raise a clear error instead of silently matching
# =============================================================================

statement error
SELECT * FROM ast_select('test/data/python/sample_app.py', '.func:totallynotreal');
----
unknown pseudo-class

statement error
SELECT * FROM ast_select('test/data/python/sample_app.py', '.func:not(:alsonotreal)');
----
unknown pseudo-class

# =============================================================================
# Custom predicates via ast_selector_predicate_* macros
# Uses a mock ast_dispatch_predicate that hardcodes test predicates via CASE.
# In production, sitting_duck auto-loads func_apply and registers a real
# dispatcher that uses apply() for dynamic dispatch.
# =============================================================================

# Define test predicate macros (these register in duckdb_functions)
statement ok
CREATE OR REPLACE MACRO ast_selector_predicate_name_starts(node, prefix) AS (
    node.name IS NOT NULL AND starts_with(node.name, prefix)
);

statement ok
CREATE OR REPLACE MACRO ast_selector_predicate_is_deep(node, arg) AS (
    node.depth >= 3
);

# Mock dispatcher: routes by function name to hardcoded predicate implementations
statement ok
CREATE OR REPLACE MACRO ast_dispatch_predicate(fn, node, arg) AS (
    CASE fn
        WHEN 'ast_selector_predicate_name_starts'
            THEN node.name IS NOT NULL AND starts_with(node.name, arg)
        WHEN 'ast_selector_predicate_is_deep'
            THEN node.depth >= 3
        ELSE false
    END
);

# Custom predicate with argument — 2 functions start with "outer"
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:name_starts("outer")');
----
2

# Custom predicate with no argument (arg is NULL)
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:is_deep');
----
true

# Negation: :not(:custom_pred)
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:not(:is_deep)');
----
true

# Custom predicate combined with built-in pseudo-class
# :named:is_deep — named function definitions at depth >= 3 (the 2 inner functions)
query I
SELECT COUNT(*) FROM ast_select('test/data/python/macros/recursive_match.py',
    'function_definition:named:is_deep');
----
2

# Discoverability: registered predicates appear in duckdb_functions()
query I
SELECT COUNT(*) >= 2 FROM duckdb_functions()
WHERE function_name LIKE 'ast_selector_predicate_%';
----
true

# Error: unknown custom predicate (no matching macro registered)
statement error
SELECT * FROM ast_select('test/data/python/sample_app.py', '.func:no_such_predicate');
----
unknown pseudo-class
