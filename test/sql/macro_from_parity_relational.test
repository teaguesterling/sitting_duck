----
0

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_not_has_from('t', 'function_definition', 'class_definition');
----
20	2d33ce95821ca03e0f3dd8b223c9d7be

