# name: test/sql/css_selectors_multilang_part03.test
# (part 3 of 15 — split from css_selectors_multilang.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Comprehensive CSS selector tests across multiple languages.
# Tests type selectors, ID selectors, class (semantic) selectors,
# combinators (descendant, child, adjacent sibling, general sibling),
# pseudo-classes (:has, :not, :first-child, :last-child, :named, :definition, :scope),
# and ast_select_from (pre-parsed table queries).
#
# Test fixtures:
#   test/data/python/css_selectors_test.py
#   test/data/javascript/css_selectors_test.js
#   test/data/rust/css_selectors_test.rs
#   test/data/go/css_selectors_test.go
#   test/data/rosetta/Lang/*/Factorial/*
#   test/data/rosetta/Lang/*/Abstract-type/*

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# 1. TYPE SELECTORS across languages
# =============================================================================
# Each language uses different AST node types for the same concepts.

# Compound filters apply uniformly regardless of root selector type:
# .func#main should match only the single function named main (not calls/identifiers).
query II
SELECT type, name FROM ast_select('test/data/python/css_selectors_test.py', '.func#main')
ORDER BY start_line;
----
function_definition	main

# type#name compound with non-matching class — must match NOTHING,
# previously matched every node named "main" because class_filter leaked.
query I
SELECT COUNT(*) FROM ast_select('test/data/python/css_selectors_test.py', 'function_definition.class#main');
----
0

# function_definition#ExecuteRecursivePipelines works on any file — the strict
# type form always matches exactly the definition, not call sites.
# Three shapes that should all return the same row:
query I
SELECT type FROM ast_select('test/data/python/css_selectors_test.py', '.func#main')
ORDER BY start_line;
----
function_definition

query I
SELECT type FROM ast_select('test/data/python/css_selectors_test.py', 'function_definition#main')
ORDER BY start_line;
----
function_definition

# Bare #main has no type/class filter, so also matches the identifier
# node that IS the function name.
query I
SELECT type FROM ast_select('test/data/python/css_selectors_test.py', '#main')
ORDER BY type;
----
function_definition
identifier

# =============================================================================
# 3. ID SELECTORS (#name) across languages
# =============================================================================

# Python: function by name
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', 'function_definition#main');
----
main

# Python: class by name
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', 'class_definition#Dog');
----
Dog

# JavaScript: class by name
query I
SELECT name FROM ast_select('test/data/javascript/css_selectors_test.js', 'class_declaration#Circle');
----
Circle
