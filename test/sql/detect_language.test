# name: test/sql/detect_language.test
# group: [sql]

# Test detect_language() scalar function

require sitting_duck

statement ok
LOAD sitting_duck;

# Basic language detection from file extensions
query I
SELECT detect_language('src/main.py');
----
python

query I
SELECT detect_language('lib/parser.rs');
----
rust

query I
SELECT detect_language('app/index.js');
----
javascript

query I
SELECT detect_language('styles.css');
----
css

query I
SELECT detect_language('config.json');
----
json

query I
SELECT detect_language('Makefile.sh');
----
bash

query I
SELECT detect_language('main.go');
----
go

query I
SELECT detect_language('App.java');
----
java

query I
SELECT detect_language('query.sql');
----
sql

# Case-insensitive extension matching
query I
SELECT detect_language('README.PY');
----
python

# Unrecognized extensions return NULL
query I
SELECT detect_language('data.csv');
----
NULL

query I
SELECT detect_language('notes.txt');
----
NULL

# No extension returns NULL
query I
SELECT detect_language('Makefile');
----
NULL

# URI paths are handled (git:// scheme stripped)
query I
SELECT detect_language('git://./src/main.py@HEAD');
----
python

# Works with column values - detect language for each file
query II
SELECT path, detect_language(path) as lang
FROM (VALUES ('a.py'), ('b.rs'), ('c.csv'), ('d.ts')) t(path)
ORDER BY path;
----
a.py	python
b.rs	rust
c.csv	NULL
d.ts	typescript

# Values match ast_supported_languages
query I
SELECT detect_language('test.py') IN (SELECT language FROM ast_supported_languages());
----
true

# =============================================================================
# THE EXTENSION TABLES ARE WRITTEN TWICE, so they are checked against each other
# =============================================================================
#
# src/ast_file_utils.cpp holds two separate literals: EXTENSION_TO_LANGUAGE,
# which detect_language() reads, and LANGUAGE_TO_EXTENSIONS, which an explicit
# language argument filters candidate files through. Nothing kept them in step
# until this test. A one-sided edit is silent in both directions:
#
#   * an extension added only to EXTENSION_TO_LANGUAGE detects correctly and
#     then matches no file when the language is named;
#   * an extension added only to LANGUAGE_TO_EXTENSIONS is accepted when the
#     language is named and auto-detects as nothing.
#
# Adding tsx in #329 required editing both by hand, and moving `.tsx` off
# typescript required editing both again.

query I
SELECT count(*) FROM (
    SELECT language, unnest(extensions) AS ext FROM ast_supported_languages()
) WHERE detect_language('somefile.' || ext) <> language;
----
0

# Guard, and the reason the assertion above is not vacuous: an empty extension
# list for every language would make "nothing disagrees" trivially true.
query I
SELECT count(*) > 50 FROM (SELECT unnest(extensions) FROM ast_supported_languages());
----
true

# The other side of the pair. A language with no extensions cannot be reached by
# an explicit language argument at all -- every candidate file is filtered out.
# duckdb is the only one that is meant to be in that state: it parses SQL text
# through DuckDB's own parser and owns no file extension.
query I
SELECT string_agg(language, ', ' ORDER BY language) FROM ast_supported_languages()
WHERE len(extensions) = 0;
----
duckdb

# PLANTED CONTROL for the assertion above, using the pairing that was real
# before #329: typescript claiming `.tsx`. The comparison must report it. A
# check that cannot be made to fail is indistinguishable from one that is not
# looking, and this one reads two maps that agree today.
query I
SELECT count(*) FROM (VALUES ('typescript', 'tsx'), ('javascript', 'ts')) t(language, ext)
WHERE detect_language('somefile.' || ext) <> language;
----
2
