# name: test/sql/macro_split_oracle.test
# description: M2 stage 3 -- splitting tree_navigation.sql must not add or drop a macro
# group: [sitting_duck]

# tree_analysis.sql was split out of tree_navigation.sql. This is a guard, not a
# red test: it passes before and after the split, and fails if a macro is lost.
# The counts are 44 macros from src/sql_macros/ plus the ast_dispatch_predicate
# stub created in src/ast_sql_macros.cpp.
#
# DELIBERATE CHANGES, RECORDED HERE AS THEY LAND
# ----------------------------------------------
# M2 stage 3 adds a `_from` variant to each core macro: it takes the NAME of a
# table that already holds a parsed AST and reads it with query_table(), so the
# macro also serves an AST parsed elsewhere. The path-taking twin then becomes a
# thin wrapper that calls read_ast() and delegates, as ast_select delegates to
# ast_select_from. A wrapper has a different `macro_definition` from the body it
# replaces, so each twin's definition changes BY DESIGN. The five below are the
# relational operators (task 4 of the stage, src/sql_macros/relational_operators.sql):
#
#   ast_has      -> ast_has_from       ast_precedes -> ast_precedes_from
#   ast_not_has  -> ast_not_has_from   ast_follows  -> ast_follows_from
#   ast_inside   -> ast_inside_from
#
# Parity between each twin and its `_from` form is asserted in
# test/sql/macro_from_parity_relational.test, against row counts and node_id
# digests measured from the twins BEFORE the rewrite.
#
# The three below are the navigation accessors (task 5 of the stage,
# src/sql_macros/tree_navigation.sql):
#
#   ast_definitions      -> ast_definitions_from
#   ast_containing_line  -> ast_containing_line_from
#   ast_in_range         -> ast_in_range_from
#
# Their parity is asserted in test/sql/macro_from_parity_navigation.test, which
# pins the WHOLE ROW over two files rather than node_id alone -- task 4's review
# measured that a count plus a node_id digest cannot see a column change.
#
# Scope: these eight only. One macro of the stage's parity gap (task 6) is not
# exempt yet, so this guard keeps full strength over every macro not yet
# touched.
#
# The counts move by +5 then +3 table macros and the same in rows: all eight new
# macros are table macros, so the scalar count must NOT move. A scalar count
# other than 45 means something else changed.

require sitting_duck

query III
SELECT
  count(*) FILTER (WHERE function_type = 'macro'),
  count(*) FILTER (WHERE function_type = 'table_macro'),
  count(*)
FROM duckdb_functions() WHERE database_name = 'memory';
----
45	60	105

# The five `_from` variants are registered, and registered as table macros.
# The count above moves by five whichever five arrive; this names them.
query II
SELECT function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'memory'
  AND function_name IN ('ast_has_from', 'ast_not_has_from', 'ast_inside_from',
                        'ast_precedes_from', 'ast_follows_from')
ORDER BY function_name;
----
ast_follows_from	table_macro
ast_has_from	table_macro
ast_inside_from	table_macro
ast_not_has_from	table_macro
ast_precedes_from	table_macro

# The three navigation `_from` variants, likewise.
query II
SELECT function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'memory'
  AND function_name IN ('ast_definitions_from', 'ast_containing_line_from',
                        'ast_in_range_from')
ORDER BY function_name;
----
ast_containing_line_from	table_macro
ast_definitions_from	table_macro
ast_in_range_from	table_macro

# The 8 macros that moved to tree_analysis.sql are still registered table macros.
query II
SELECT function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'memory'
  AND function_name IN ('ast_resolve_entity', 'ast_function_metrics',
                        'ast_functions_containing', 'ast_nesting_analysis',
                        'ast_security_audit', 'ast_dead_code',
                        'ast_get_calls', 'ast_call_graph')
ORDER BY function_name;
----
ast_call_graph	table_macro
ast_dead_code	table_macro
ast_function_metrics	table_macro
ast_functions_containing	table_macro
ast_get_calls	table_macro
ast_nesting_analysis	table_macro
ast_resolve_entity	table_macro
ast_security_audit	table_macro
