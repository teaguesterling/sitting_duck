# name: test/sql/css_selectors_multilang_part13.test
# (part 13 of 15 — split from css_selectors_multilang.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Comprehensive CSS selector tests across multiple languages.
# Tests type selectors, ID selectors, class (semantic) selectors,
# combinators (descendant, child, adjacent sibling, general sibling),
# pseudo-classes (:has, :not, :first-child, :last-child, :named, :definition, :scope),
# and ast_select_from (pre-parsed table queries).
#
# Test fixtures:
#   test/data/python/css_selectors_test.py
#   test/data/javascript/css_selectors_test.js
#   test/data/rust/css_selectors_test.rs
#   test/data/go/css_selectors_test.go
#   test/data/rosetta/Lang/*/Factorial/*
#   test/data/rosetta/Lang/*/Abstract-type/*

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# 1. TYPE SELECTORS across languages
# =============================================================================
# Each language uses different AST node types for the same concepts.

# >>> replicated-setup start (created earlier in the original; each split file is an independent DB) >>>
statement ok
CREATE TABLE py_ast AS SELECT * FROM read_ast('test/data/python/css_selectors_test.py');
# <<< replicated-setup end <<<

# Class (semantic) selector
query I
SELECT name FROM ast_select_from('py_ast', '.class')
ORDER BY name;
----
Animal
Cat
Dog

# ID selector
query I
SELECT name FROM ast_select_from('py_ast', 'function_definition#main');
----
main

# Descendant combinator
query I
SELECT name FROM ast_select_from('py_ast', 'class_definition function_definition')
ORDER BY name, start_line;
----
__init__
fetch
move
purr
speak
speak
speak

# Adjacent sibling combinator
query I
SELECT name FROM ast_select_from('py_ast', 'class_definition + class_definition')
ORDER BY name;
----
Cat
Dog

# General sibling combinator
query I
SELECT name FROM ast_select_from('py_ast', 'class_definition ~ function_definition')
WHERE depth = 1
ORDER BY name;
----
main
make_animal
process_animals

# :has()
query I
SELECT name FROM ast_select_from('py_ast', 'function_definition:has(return_statement)')
ORDER BY name, start_line;
----
fetch
make_animal
move
speak
speak
speak

# :not(:has())
query I
SELECT name FROM ast_select_from('py_ast', 'function_definition:not(:has(return_statement))')
ORDER BY name;
----
__init__
main
process_animals
purr

# :has(.class) — exercises the Bug 1/2 fix path
query I
SELECT name FROM ast_select_from('py_ast', 'function_definition:has(.call)')
ORDER BY name, start_line;
----
main
make_animal
process_animals
