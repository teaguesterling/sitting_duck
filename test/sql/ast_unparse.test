    FROM parse_ast(E'package main\n\nfunc max(a int, b int) int {\n    if a > b {\n        return a\n    }\n    return b\n}\n', 'go')
),
unp AS (
    SELECT source FROM ast_unparse_code(E'package main\n\nfunc max(a int, b int) int {\n    if a > b {\n        return a\n    }\n    return b\n}\n', 'go')
),
reparsed AS (
    SELECT string_agg(type, ' > ' ORDER BY node_id) AS sig
    FROM parse_ast_list_table((SELECT source FROM unp), 'go')
)
SELECT (SELECT sig FROM orig) = (SELECT sig FROM reparsed);
