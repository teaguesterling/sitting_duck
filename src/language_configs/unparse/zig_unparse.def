/**
 * @file zig_unparse.def
 * @brief Zig unparse formatting rules
 */

DEF_UNPARSE_INDENT("block", 1)
DEF_UNPARSE_INDENT("block_expression", 1)
DEF_UNPARSE_INDENT("struct_declaration", 1)
DEF_UNPARSE_INDENT("enum_declaration", 1)
DEF_UNPARSE_INDENT("union_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("function_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("struct_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("enum_declaration", 1)
