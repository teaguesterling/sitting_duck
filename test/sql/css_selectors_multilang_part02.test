# name: test/sql/css_selectors_multilang_part02.test
# (part 2 of 15 — split from css_selectors_multilang.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Comprehensive CSS selector tests across multiple languages.
# Tests type selectors, ID selectors, class (semantic) selectors,
# combinators (descendant, child, adjacent sibling, general sibling),
# pseudo-classes (:has, :not, :first-child, :last-child, :named, :definition, :scope),
# and ast_select_from (pre-parsed table queries).
#
# Test fixtures:
#   test/data/python/css_selectors_test.py
#   test/data/javascript/css_selectors_test.js
#   test/data/rust/css_selectors_test.rs
#   test/data/go/css_selectors_test.go
#   test/data/rosetta/Lang/*/Factorial/*
#   test/data/rosetta/Lang/*/Abstract-type/*

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# 1. TYPE SELECTORS across languages
# =============================================================================
# Each language uses different AST node types for the same concepts.

# Python: .function matches all function_definitions
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', '.function')
ORDER BY name, start_line;
----
__init__
fetch
main
make_animal
move
process_animals
purr
speak
speak
speak

# Python: .class matches all class_definitions
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', '.class')
ORDER BY name;
----
Animal
Cat
Dog

# JavaScript: .function includes both declarations AND methods
query I
SELECT name FROM ast_select('test/data/javascript/css_selectors_test.js', '.function')
ORDER BY name, start_line;
----
add
area
area
area
constructor
constructor
constructor
describe
fetchShape
greet
perimeter
processShapes

# JavaScript: .class matches class_declarations
query I
SELECT name FROM ast_select('test/data/javascript/css_selectors_test.js', '.class')
ORDER BY name;
----
Circle
Shape
Square

# Rust: .function matches function_items plus trait method declarations
# draw appears twice: once in trait Drawable decl, once in impl Drawable for Point
query I
SELECT name FROM ast_select('test/data/rust/css_selectors_test.rs', '.function')
ORDER BY name, start_line;
----
area
create_point
distance
draw
draw
helper
is_origin
new
perimeter
visible
visible

# Rust: .class matches struct_item AND trait_item (both appear twice: decl + impl)
query I
SELECT name FROM ast_select('test/data/rust/css_selectors_test.rs', '.class')
ORDER BY name;
----
Drawable
Drawable
Point
Point

# Go: .function matches function_declarations AND method_declarations
# Area and Perimeter appear twice: interface spec + struct implementation
query I
SELECT name FROM ast_select('test/data/go/css_selectors_test.go', '.function')
ORDER BY name;
----
Area
Area
Distance
Helper
NewPoint
Perimeter
Perimeter
ProcessShapes
String

# .FUNCTION is case-insensitive (same as .function)
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', '.FUNCTION')
ORDER BY name, start_line;
----
__init__
fetch
main
make_animal
move
process_animals
purr
speak
speak
speak
