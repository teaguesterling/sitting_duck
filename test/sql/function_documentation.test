# Test 3: Check parameter names are populated and not default dummy names
# ========================================================================

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'parse_ast'
  AND list_contains(parameters, 'code');
----
true

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'read_ast'
  AND list_contains(parameters, 'file_path');
----
true

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'ast_unparse_rules'
  AND list_contains(parameters, 'language');
----
true

# Test 4: All sitting_duck tagged functions have non-empty description
# ===================================================================

query I
SELECT COUNT(*) = 0
FROM duckdb_functions()
WHERE list_contains(categories, 'sitting_duck')
  AND (description IS NULL OR description = '');
----
true
