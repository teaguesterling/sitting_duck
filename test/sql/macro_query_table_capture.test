# name: test/sql/macro_query_table_capture.test
# description: M2 stage 3 (R70) - a user table named like a wrapper's internal CTE must not capture the wrapper's query_table() reference
# group: [sitting_duck]

require sitting_duck

# =============================================================================
# WHAT THIS GUARDS
# ----------------
# Nine path-taking macros parse their input into a CTE and hand that CTE's NAME,
# as a string, to the `_from` variant, which resolves it with query_table().
# A user table with the same name could, in principle, be resolved instead of
# the CTE and silently replace the parsed source. Measured correct: with a
# 1246-row decoy named __ast_has_src, ast_has returned its baseline 3 rows, not
# the 14 the decoy would give. Nothing else covered the property.
#
# The decoy is read_ast('test/data/python/sample_app.py') (1246 rows); the
# source every macro is called on is test/data/python/qualified_names.py
# (133 rows). Each call is chosen so the decoy WOULD give a different answer;
# the answer a capturing build would return is stated beside each pin, and
# section 3 measures that those answers really differ by calling each `_from`
# variant on the decoy directly.
#
# THIS FILE IS A FLOOR, NOT A CENSUS. It covers the nine wrappers this branch
# added delegation to. Six more internal names exist in pre-existing wrappers
# and are NOT covered here, because they are out of this branch's scope:
# __ast_src, __ast_blocks_src, __ast_replace_src, __sdx_src, __sdx_code_src,
# __sdx_from_file.
# =============================================================================

statement ok
CREATE TABLE __ast_has_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_not_has_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_inside_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_precedes_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_follows_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_in_range_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_containing_line_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_definitions_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

statement ok
CREATE TABLE __ast_source_of_src AS SELECT * FROM read_ast('test/data/python/sample_app.py');

# 1. The decoys exist and are the large table: nine rows of 1246.
query I
SELECT count(*) FROM (
  SELECT count(*) AS n FROM __ast_has_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_not_has_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_inside_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_precedes_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_follows_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_in_range_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_containing_line_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_definitions_src
  UNION ALL
  SELECT count(*) AS n FROM __ast_source_of_src
) WHERE n = 1246;
----
9

# 2. Each macro still answers from its own parse of qualified_names.py.
#    Column order: has, not_has, inside, precedes, follows, in_range,
#    containing_line, definitions, source_of.
#    A capturing build would instead give:  14, 6, 18, 0, 5, 34, 2, 42, 0.
query IIIIIIIII
SELECT
  (SELECT count(*) FROM ast_has('test/data/python/qualified_names.py', 'function_definition', 'return_statement')),
  (SELECT count(*) FROM ast_not_has('test/data/python/qualified_names.py', 'function_definition', 'return_statement')),
  (SELECT count(*) FROM ast_inside('test/data/python/qualified_names.py', 'return_statement', 'function_definition')),
  (SELECT count(*) FROM ast_precedes('test/data/python/qualified_names.py', 'function_definition', 'class_definition')),
  (SELECT count(*) FROM ast_follows('test/data/python/qualified_names.py', 'function_definition', 'class_definition')),
  (SELECT count(*) FROM ast_in_range('test/data/python/qualified_names.py', 1, 10)),
  (SELECT count(*) FROM ast_containing_line('test/data/python/qualified_names.py', 6)),
  (SELECT count(*) FROM ast_definitions('test/data/python/qualified_names.py')),
  (SELECT count(*) FROM ast_source_of('test/data/python/qualified_names.py', 'Account'));
----
3	3	3	1	1	52	13	11	1

# 3. The decoy would have changed every one of those nine answers. The same
#    calls through the `_from` variants, pointed at the decoy by name. The
#    source_of cell is the decoy's own count of 'Account' matches (0), since a
#    capturing call would match nothing in the decoy.
query IIIIIIIII
SELECT
  (SELECT count(*) FROM ast_has_from('__ast_has_src', 'function_definition', 'return_statement')),
  (SELECT count(*) FROM ast_not_has_from('__ast_not_has_src', 'function_definition', 'return_statement')),
  (SELECT count(*) FROM ast_inside_from('__ast_inside_src', 'return_statement', 'function_definition')),
  (SELECT count(*) FROM ast_precedes_from('__ast_precedes_src', 'function_definition', 'class_definition')),
  (SELECT count(*) FROM ast_follows_from('__ast_follows_src', 'function_definition', 'class_definition')),
  (SELECT count(*) FROM ast_in_range_from('__ast_in_range_src', 1, 10)),
  (SELECT count(*) FROM ast_containing_line_from('__ast_containing_line_src', 6)),
  (SELECT count(*) FROM ast_definitions_from('__ast_definitions_src')),
  (SELECT count(*) FROM __ast_source_of_src WHERE name = 'Account');
----
14	6	18	0	5	34	2	42	0
