# =============================================================================
# 6. The optional name arguments, which every tuple above leaves NULL
# =============================================================================
#
# Section 1-5 cannot see a wrapper that drops or swaps an optional parameter,
# because NULL is also what a lost argument looks like. Each pair below is
# asserted twice -- once through the twin, once through the `_from` form -- and
# both are pinned to the SAME pre-change measurement, so a dropped argument on
# either side fails here.
#
# Each named count differs from its unnamed count in section 1-5, so the
# assertion also fails if the name is accepted and then ignored:
#   ast_has       3 -> 1     ast_precedes  16 -> 4
#   ast_not_has   0 -> 2     ast_follows   16 -> 2
#   ast_inside   15 -> 1
# ast_inside is the one with two optional names. 'UserService' is a class and
# 'get_user' a method inside it, so exchanging the two arguments returns 0 rows
# -- the swap this pair exists to catch.

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition', descendant_name := 'connect');
----
1	7ef605fc8dba5425d6965fbd4c8fbe1f

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_has_from('t', 'class_definition', 'function_definition', descendant_name := 'connect');
----
1	7ef605fc8dba5425d6965fbd4c8fbe1f

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_not_has('test/data/python/sample_app.py', 'class_definition', 'function_definition', descendant_name := 'connect');
----
2	719762d688dd8845669cc180c3070e37

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_not_has_from('t', 'class_definition', 'function_definition', descendant_name := 'connect');
----
2	719762d688dd8845669cc180c3070e37

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_inside('test/data/python/sample_app.py', 'function_definition', 'class_definition',
                ancestor_name := 'UserService', descendant_name := 'get_user');
----
1	f8c1f23d6a8d8d7904fc0ea8e066b3bb

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_inside_from('t', 'function_definition', 'class_definition',
                     ancestor_name := 'UserService', descendant_name := 'get_user');
----
1	f8c1f23d6a8d8d7904fc0ea8e066b3bb

# The swap control. Without it the pair above passes on any implementation that
# applies both names to the same side.
query I
SELECT count(*) FROM ast_inside_from('t', 'function_definition', 'class_definition',
                                     ancestor_name := 'get_user', descendant_name := 'UserService');
----
0

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_precedes('test/data/python/sample_app.py', 'function_definition', 'function_definition', before_name := 'main');
----
4	bf5d8f5b4d8bf170c4217c291bc031cb

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_precedes_from('t', 'function_definition', 'function_definition', before_name := 'main');
----
4	bf5d8f5b4d8bf170c4217c291bc031cb

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_follows('test/data/python/sample_app.py', 'function_definition', 'function_definition', after_name := 'validate_email');
----
2	fdb73069ae551ed61b0d876ec6c50fff

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_follows_from('t', 'function_definition', 'function_definition', after_name := 'validate_email');
----
2	fdb73069ae551ed61b0d876ec6c50fff

# The twins keep a `language` parameter the `_from` forms do not have, and a
# wrapper that drops it would silently fall back to extension detection -- which
# on a .py file gives the right answer, so a row count cannot see the loss.
# A language the file does not match leaves read_ast with no file to read, and
# that error is visible. Measured pre-change.
statement error
SELECT * FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition', language := 'javascript');
----
read_ast needs at least one file to read

# =============================================================================
# 7. A missing table names itself, and an empty table is not an error
# =============================================================================

statement error
SELECT * FROM ast_has_from('no_such_table', 'class_definition', 'function_definition');
----
no_such_table

# Well-formed and empty: the columns are read_ast's, there are no rows. Each
# `_from` macro must return 0 rows rather than raise.
statement ok
CREATE TABLE empty_ast AS SELECT * FROM read_ast('test/data/python/sample_app.py') WHERE false;

query I
SELECT count(*) FROM empty_ast;
----
0

query IIIII
SELECT
  (SELECT count(*) FROM ast_has_from('empty_ast', 'class_definition', 'function_definition')),
  (SELECT count(*) FROM ast_not_has_from('empty_ast', 'function_definition', 'class_definition')),
  (SELECT count(*) FROM ast_inside_from('empty_ast', 'function_definition', 'class_definition')),
  (SELECT count(*) FROM ast_precedes_from('empty_ast', 'import_statement', 'class_definition')),
  (SELECT count(*) FROM ast_follows_from('empty_ast', 'function_definition', 'class_definition'));
----
0	0	0	0	0
