/**
 * @file java_unparse.def
 * @brief Java Tier-3 unparse formatting rules
 */

DEF_UNPARSE_INDENT("block", 1)
DEF_UNPARSE_INDENT("class_body", 1)
DEF_UNPARSE_LINES_BEFORE("class_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("method_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("constructor_declaration", 1)
