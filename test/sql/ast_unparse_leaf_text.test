# =============================================================================
# 3. Whole-corpus aggregate
# =============================================================================
# Defence in depth: one query over the whole corpus, so a language added to
# test/data/unparse_leaf_text/ is covered even before it gets its own block
# above.

query I
SELECT count(*) FROM read_ast('test/data/unparse_leaf_text/*', peek_mode := 'full')
WHERE children_count = 0 AND COALESCE(NULLIF(name, ''), type) <> peek;
----
0

# The corpus must actually span the built-in tree-sitter languages, otherwise
# the zero above could be vacuous.
#
# Pinned EXACTLY rather than as `>= 26`: a one-sided bound still passes if a
# language silently disappears from the corpus, which is the regression this
# guard exists to catch (#202's shape -- an assertion loose enough to pass for
# more than one state of the world is not a measurement). 27 = every
# tree-sitter language; `duckdb` is excluded by construction, see
# ast_unparse_exact.test's NOT COVERED note.
query I
SELECT count(DISTINCT language) = 27 FROM read_ast('test/data/unparse_leaf_text/*')
WHERE children_count = 0;
----
true

# =============================================================================
# 4. Regression guards for the classes the static derivation could not see
# =============================================================================
# These four were found by sweeping a parsed corpus, not by reading parser.c,
# and each is a distinct structural class. They are pinned individually
# because a future grammar bump could silently reintroduce any of them.

# ruby: tree-sitter reuses ONE token symbol for both quote characters, so the
# single-quote delimiter has type `"`. Without a text strategy a single-quoted
# string round-tripped with a double quote: x = "hi".
query T
SELECT source FROM ast_unparse_code('x = ''hi''', 'ruby');
----
x = 'hi'

# lua: the anonymous token `[[` also matches `--[[`, so its type is not its
# text. The comment opener was emitted as `[[`.
query T
SELECT source LIKE '--[[%' FROM ast_unparse_code('--[[ c ]] x = 1', 'lua');
----
true

# dart: `comment` is a named NON-terminal whose children are all hidden, so it
# arrives with children_count = 0. Its symbol id is past TOKEN_COUNT, which is
# why a terminals-only derivation misses it.
query T
SELECT replace(source, chr(10), '|') FROM ast_unparse_code('/* c */' || chr(10) || 'var x = 1;', 'dart');
----
/* c */|var x = 1;

# kotlin: `interpolated_identifier` is a visible+named ALIAS symbol; alias ids
# also sit past TOKEN_COUNT. The interpolated name was emitted as the literal
# string "interpolated_identifier".
query T
SELECT source LIKE '%a $ b%' FROM ast_unparse_code('val s = "a$b"', 'kotlin');
----
true

# sql: comments are the one non-keyword class fixed for sql in this change.
query T
SELECT replace(source, chr(10), '|') FROM ast_unparse_code('-- hi' || chr(10) || 'SELECT 1;', 'sql');
----
-- hi|SELECT 1;

# sql keyword_* leaves. These were the last gap in the language: 209 named
# keyword leaves that no DEF_TYPE entry configured, so every FIND_*/FIRST_CHILD
# strategy returned "" on them and ast_unparse.sql's
# COALESCE(NULLIF(name, ''), type) emitted the TYPE where the TEXT belongs.
#
# WHY THESE INPUTS. Each uses keywords that were in the uncovered 209, not the
# 141 that already worked -- a round-trip through keyword_select would have
# passed before the fix and proves nothing. Measured before the fix, on the
# binary built from the previous commit:
#
#   keyword_zerofill -> name '', flags 0     (so unparse emitted "keyword_zerofill")
#
# and ON DELETE NO ACTION round-tripped as "keyword_no keyword_action", which is
# what scripts/apply_leaf_text_fixes.py records as the verified symptom.
#
# The assertion is byte-exact equality with the input, not non-emptiness: a
# round-trip that emits a type name is still a non-empty string, so a
# non-emptiness check cannot tell the two apart.
query T
SELECT source = 'CREATE TABLE t(a INT REFERENCES u(b) ON DELETE NO ACTION);'
FROM ast_unparse_code('CREATE TABLE t(a INT REFERENCES u(b) ON DELETE NO ACTION);', 'sql');
----
true

# The name must be the keyword's own text, and the keyword flag must be set.
# Both columns moved in this change; the semantic type deliberately did not,
# because PARSER_CONSTRUCT is what PopulateSemanticFieldsTemplated already
# assigned to these unconfigured types.
#
# The predicate is is_syntax_only, not an is_keyword: node_config.hpp:130
# defines IS_KEYWORD as an ALIAS for IS_SYNTAX_ONLY rather than its own bit. So
# setting it also flips is_construct to false for these 209 types, which is the
# correct answer for a keyword and is asserted here so the second-order effect
# is pinned rather than discovered later.
query TTTT
SELECT name, semantic_type, is_syntax_only(flags), is_construct(flags)
FROM parse_ast('CREATE TABLE t(a INT ZEROFILL);', 'sql')
WHERE type = 'keyword_zerofill';
----
ZEROFILL	PARSER_CONSTRUCT	true	false
