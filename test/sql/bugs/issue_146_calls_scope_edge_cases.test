# name: test/sql/bugs/issue_146_calls_scope_edge_cases.test
# description: #146 — :calls/:called-by bind to the IMMEDIATE enclosing function, not to every ancestor
# group: [bugs]

# #146 reported that `:calls(name)` is "plain containment, not scope-aware as
# documented: an outer function matches". Measured on current main it is
# scope-aware. This file exists so that it stays that way, and so that a future
# change has to break a named case rather than a count.
#
# WHAT MAKES THIS SUBTLE, and why the cases are paired. A containment
# implementation and a scope-aware one agree on most inputs -- both say
# `level3` calls `deep`. They disagree only where a call sits in a scope
# NESTED inside the candidate function. So every discriminating case below is
# paired with a CONTROL that a naive "exclude anything with a nested call" fix
# would break. Getting one right and the other wrong is the likely failure
# mode, which is why neither is omitted.
#
# Fixture: test/data/callgraph/edge_cases.py, annotated per call with the scope
# it must be attributed to. It deliberately lives outside test/data/python/,
# whose `*.py` glob 49 other assertions depend on.

require sitting_duck

# =============================================================================
# 1. DEPTH — a call three scopes down belongs to the innermost one only
# =============================================================================

# level1 > level2 > level3, and only level3 calls deep().
# A containment implementation answers 1 for all three.

query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#level1:calls(deep)');
----
0

query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#level2:calls(deep)');
----
0

# CONTROL: the immediate scope still matches. Without this, "always 0" passes.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#level3:calls(deep)');
----
1

# =============================================================================
# 2. LAMBDA — a lambda is a function scope and owns the calls inside it
# =============================================================================

# method_lambda returns `lambda: from_lambda()`. The lambda owns that call,
# so the enclosing METHOD does not match. (#152's ruling, from the :calls side.)
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#method_lambda:calls(from_lambda)');
----
0

# A method IS a function scope, so an ordinary method call attributes normally.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#method:calls(from_method)');
----
1

# =============================================================================
# 3. OVER-CORRECTION — the case a careless fix breaks
# =============================================================================

# direct_and_nested() calls both() DIRECTLY and also contains a nested
# function that calls both(). The direct call still counts: a fix that
# excluded any function having a nested call to the same callee would turn
# this into 0 while leaving section 1 green.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#direct_and_nested:calls(both)');
----
1

# Both scopes match independently, so the class-level count is 2, not 1.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.fn:calls(both)');
----
2

# =============================================================================
# 4. SIBLINGS, SELF-CALLS, AND A NON-FUNCTION SCOPE
# =============================================================================

# Two sibling functions calling the same name are two independent matches.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.fn:calls(shared)');
----
2

# A self-call attributes to the function itself rather than being dropped.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#recurse:calls(recurse)');
----
1

# A list comprehension is NOT a function scope in this grammar, so the call
# inside it belongs to the enclosing def. This pins the boundary: only
# function-shaped scopes capture a call.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', 'function_definition#with_comprehension:calls(each)');
----
1

# =============================================================================
# 5. THE :called-by DIRECTION — must agree with :calls
# =============================================================================

query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call:called-by(level1)');
----
0

query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call:called-by(level3)');
----
1

query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call:called-by(method_lambda)');
----
0

# direct_and_nested owns exactly ONE of the two both() calls.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call:called-by(direct_and_nested)');
----
1

# =============================================================================
# 6. MODULE SCOPE — a call with no enclosing function is attributed to nothing
# =============================================================================

# Structural, not a magic number: of the calls in this file, exactly one sits
# at module level, so bare :called-by must match all but that one. Asserting
# the pair makes the relationship the thing under test -- if a call is added to
# the fixture, both move together or this fails.
query I
SELECT (SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call'))
     - (SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call:called-by'));
----
1

# And that one call is not attributable to any function.
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.call#at_module_level:called-by');
----
0

# =============================================================================
# 7. NEGATIVE CONTROL — the selector can return 0 for a real reason
# =============================================================================

# Without this, every 0 above could be "the predicate never matches anything".
query I
SELECT COUNT(*) FROM ast_select('test/data/callgraph/edge_cases.py', '.fn:calls(no_such_function)');
----
0

# ... and the same shape finds something when the callee does exist, so the
# zero above is about the NAME, not about the selector being broken.
query I
SELECT COUNT(*) > 0 FROM ast_select('test/data/callgraph/edge_cases.py', '.fn:calls(deep)');
----
true
