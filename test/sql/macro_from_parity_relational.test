# name: test/sql/macro_from_parity_relational.test
# description: M2 stage 3 -- the five relational _from variants agree with their path-taking twins
# group: [sitting_duck]
#
# WHAT THIS GUARDS
# ----------------
# ast_has / ast_not_has / ast_inside / ast_precedes / ast_follows each gained a
# `_from` variant that reads an already-parsed AST table with query_table()
# instead of calling read_ast() itself. The twins were then rewritten as thin
# wrappers that parse and delegate, following ast_select / ast_select_from.
#
# THE EXCEPT PAIRS BELOW ONLY COMPARED TWO INDEPENDENT BODIES ONCE: on the
# build where the `_from` macros existed and the twins did NOT yet delegate to
# them. From the wrapper rewrite onwards both sides of each EXCEPT evaluate the
# same body, so the pairs are self-referential and can no longer fail. They are
# kept because they are cheap and they still catch a wrapper that forwards the
# wrong arguments, loses columns, or changes row multiplicity.
#
# THE PINNED COUNTS AND HASHES ARE WHAT CARRY POWER AFTER THAT POINT. Every
# pinned value in this file was MEASURED on commit 4d4252e, from the
# path-taking twins BEFORE any of this task's changes -- that is, from the
# implementation this task replaces, not from the one it introduces. A pin that
# moves is a parity failure to investigate, never a value to update.
#
# The argument tuples are measured non-empty, and two obvious choices are not:
# 'class_definition'/'function_definition' returns 0 rows for ast_not_has and
# for ast_precedes, because every class in sample_app.py contains a function
# and no function precedes a class. A zero baseline makes an EXCEPT vacuous.

require sitting_duck

# The pre-parsed table every `_from` call below reads. Default extraction
# options, exactly as the twins' own read_ast() call uses them, or the EXCEPT
# would differ in the peek column rather than in the predicate.
statement ok
CREATE TABLE t AS SELECT * FROM read_ast('test/data/python/sample_app.py');

# =============================================================================
# 1. ast_has
# =============================================================================

# The baseline must not be empty, or EXCEPT proves nothing.
query I
SELECT count(*) > 0 FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition');
----
true

query I
SELECT count(*) FROM (
  SELECT * FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition')
  EXCEPT SELECT * FROM ast_has_from('t', 'class_definition', 'function_definition')
);
----
0

# The other direction, which catches a `_from` form returning extra rows.
query I
SELECT count(*) FROM (
  SELECT * FROM ast_has_from('t', 'class_definition', 'function_definition')
  EXCEPT SELECT * FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition')
);
----
0

# Pinned: absolute row count and node_id digest, measured pre-change.
query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_has_from('t', 'class_definition', 'function_definition');
----
3	a32099295b23cba7e6cd1c300eca0d65

# =============================================================================
# 2. ast_not_has
# =============================================================================

query I
SELECT count(*) > 0 FROM ast_not_has('test/data/python/sample_app.py', 'function_definition', 'class_definition');
----
true

query I
SELECT count(*) FROM (
  SELECT * FROM ast_not_has('test/data/python/sample_app.py', 'function_definition', 'class_definition')
  EXCEPT SELECT * FROM ast_not_has_from('t', 'function_definition', 'class_definition')
);
----
0

query I
SELECT count(*) FROM (
  SELECT * FROM ast_not_has_from('t', 'function_definition', 'class_definition')
  EXCEPT SELECT * FROM ast_not_has('test/data/python/sample_app.py', 'function_definition', 'class_definition')
);
----
0

query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_not_has_from('t', 'function_definition', 'class_definition');
----
20	2d33ce95821ca03e0f3dd8b223c9d7be

