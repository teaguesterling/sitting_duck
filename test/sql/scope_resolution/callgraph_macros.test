# name: test/sql/scope_resolution/callgraph_macros.test
# group: [scope_resolution]

# Characterisation tests for the call-graph surface: the standalone table macros
# ast_callees / ast_callers (which had NO test coverage at all — issue #203) and
# the points where they provably DISAGREE with the ::callees / ::callers selector
# pseudo-elements and the :calls / :called-by pseudo-classes.
#
# PURPOSE: this file is a safety net, not a specification of what the semantics
# OUGHT to be. It pins the behaviour that exists today — "direct, name-matched
# (not resolved)" per tracker/features/043 — so that the 043 Part A / 048 #6
# call-graph work, or any future attempt to unify these overlapping spellings,
# cannot silently change which rows come back.
#
# Every assertion below names actual values. None is of the `COUNT(*) >= 0`
# shape (issue #202), which is true for every possible result and therefore
# cannot fail.
#
# ORDERING: ast_callees and ast_callers both ORDER BY (file_path, line) only, so
# two calls on the SAME line come back in an unspecified order — observed to
# differ between the two macros for css_selectors_test.py line 43. Every query
# here therefore adds `callee` to its own ORDER BY. Do not remove it; without it
# these assertions are flaky rather than wrong.

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# ast_callees — Python, full row set
# =============================================================================
# `caller` comes from scope.function (the IMMEDIATE enclosing function), `callee`
# is the call expression's bare name. Note `speak` and `fetch`: these are METHOD
# calls (`animal.speak()`, `animal.fetch("ball")`) and are reported by the bare
# method name with no receiver and no resolution — the name-match imprecision.

query IIII
SELECT caller, caller_line, callee, callee_line
FROM ast_callees('test/data/python/css_selectors_test.py')
ORDER BY callee_line, callee;
----
make_animal	33	Dog	35
make_animal	33	Cat	37
make_animal	33	Animal	38
process_animals	41	print	43
process_animals	41	speak	43
process_animals	41	isinstance	44
process_animals	41	fetch	45
main	48	make_animal	49
main	48	make_animal	50
main	48	process_animals	51

# The grain is the CALL SITE, not the (caller, callee) pair: main() calls
# make_animal twice and gets two rows, distinguished only by callee_line.
query I
SELECT count(*) FROM ast_callees('test/data/python/css_selectors_test.py')
WHERE caller = 'main' AND callee = 'make_animal';
----
2

# =============================================================================
# ast_callees is DIRECT (immediate scope), lambda-aware — #152
# =============================================================================
# outer() calls helper(); a lambda named `inner` calls helper2(); nested() calls
# helper3(). Each call is attributed to its IMMEDIATE enclosing function, so
# outer's only callee is helper — NOT the transitive {helper, helper2, helper3}.

query IIII
SELECT caller, caller_line, callee, callee_line
FROM ast_callees('test/data/python/callgraph_direct.py')
ORDER BY callee_line, callee;
----
outer	4	helper	5
inner	6	helper2	6
nested	7	helper3	8

# =============================================================================
# ast_callers — Python, and the '<module>' row ast_callees cannot produce
# =============================================================================
# sample_app.py calls main() at module level under `if __name__ == "__main__":`.
# ast_callers LEFT-joins the enclosing function, so that call survives with
# caller = '<module>' and caller_line = 0.

query IIII
SELECT caller, caller_line, callee, call_line
FROM ast_callers('test/data/python/sample_app.py')
WHERE callee = 'main'
ORDER BY call_line;
----
<module>	0	main	163

# ast_callees INNER-joins and requires a non-empty caller name, so the very same
# call is absent entirely. This is the headline divergence between the two macros.
query I
SELECT count(*) FROM ast_callees('test/data/python/sample_app.py')
WHERE callee = 'main';
----
0

# =============================================================================
# Anonymous enclosing scopes — where the two macros disagree again
# =============================================================================
# callgraph_anon_scope.py is built for this: an anonymous lambda (passed as an
# argument, so there is no assignment target whose name could be inferred) calls
# anon_target(). sitting_duck DOES infer a name for an assigned lambda, so
# `bound = lambda: bound_target()` has caller 'bound' and is NOT affected.

# ast_callees DROPS the anonymous-lambda call entirely: anon_target appears under
# no caller at all. module_target is dropped too (module level).
query IIII
SELECT caller, caller_line, callee, callee_line
FROM ast_callees('test/data/python/callgraph_anon_scope.py')
ORDER BY callee_line, callee;
----
named	36	named_target	37
uses_anon_lambda	40	sorted	42
bound	45	bound_target	45
calls_twice	48	twice_target	49
calls_twice	48	twice_target	50

# ast_callers keeps BOTH: the anonymous-lambda call with an EMPTY caller (not
# '<module>' — scope.function matched a real but unnamed lambda node), and the
# module-level call as '<module>'.
# The empty caller is rendered here as '<EMPTY>' only because the sqllogictest
# harness splits expected rows on tabs and cannot represent a leading empty
# field. The assertion below pins caller = '' directly.
query IIII
SELECT CASE WHEN caller = '' THEN '<EMPTY>' ELSE caller END AS caller,
       caller_line, callee, call_line
FROM ast_callers('test/data/python/callgraph_anon_scope.py')
ORDER BY call_line, callee;
----
named	36	named_target	37
<EMPTY>	42	anon_target	42
uses_anon_lambda	40	sorted	42
bound	45	bound_target	45
calls_twice	48	twice_target	49
calls_twice	48	twice_target	50
<module>	0	module_target	53

# The anonymous-lambda caller is the EMPTY STRING, not NULL and not '<module>'.
# COALESCE(f.name,'<module>') only fires when the LEFT JOIN found no function at
# all; here it found the lambda, whose name is ''.
query III
SELECT caller = '' AS is_empty_string, caller IS NULL AS is_null, callee
FROM ast_callers('test/data/python/callgraph_anon_scope.py')
WHERE callee = 'anon_target';
----
true	false	anon_target

# Stated as a single difference: ast_callers sees 7 call sites, ast_callees 5.
query II
SELECT
    (SELECT count(*) FROM ast_callers('test/data/python/callgraph_anon_scope.py')),
    (SELECT count(*) FROM ast_callees('test/data/python/callgraph_anon_scope.py'));
----
7	5

# =============================================================================
# ast_callers / ast_callees across languages
# =============================================================================
# scope.function must be populated by each language adapter for these macros to
# return anything at all, so this is coverage of the extraction layer too.

# JavaScript — method calls reported by bare name (log, json, area, describe)
query IIII
SELECT caller, caller_line, callee, call_line
FROM ast_callers('test/data/javascript/css_selectors_test.js')
ORDER BY call_line, callee;
----
greet	3	log	4
fetchShape	51	fetch	53
fetchShape	51	json	54
fetchShape	51	error	57
processShapes	62	area	64
processShapes	62	describe	65
processShapes	62	log	65

# Go — a method on a value receiver (String) is a caller like any other function
query IIII
SELECT caller, caller_line, callee, call_line
FROM ast_callers('test/data/go/css_selectors_test.go')
ORDER BY call_line, callee;
----
String	20	Sprintf	21
ProcessShapes	42	Area	44
ProcessShapes	42	Area	45
ProcessShapes	42	Println	45

# Rust — two `powi` calls on one line, and `Point::new` reported as bare `new`
query IIII
SELECT caller, caller_line, callee, callee_line
FROM ast_callees('test/data/rust/css_selectors_test.rs')
ORDER BY callee_line, callee;
----
distance	13	powi	14
distance	13	powi	14
distance	13	sqrt	14
create_point	37	new	38

# =============================================================================
# The macros vs the selector pseudo-elements — three real divergences
# =============================================================================

# (1) GRAIN. calls_twice calls twice_target twice. ::callers returns DISTINCT
# caller-FUNCTION nodes (1 row); ast_callers returns one row per CALL SITE (2).
query I
SELECT count(*) FROM ast_select('test/data/python/callgraph_anon_scope.py',
    '.func#twice_target::callers');
----
1

query I
SELECT count(*) FROM ast_callers('test/data/python/callgraph_anon_scope.py')
WHERE callee = 'twice_target';
----
2

# (2) ANONYMOUS SCOPES are not recoverable through ::callees either. It keys on
# `scope.function = m.node_id`, so the call inside the anonymous lambda belongs to
# the LAMBDA, not to uses_anon_lambda — and the lambda has no name to address it
# with. uses_anon_lambda's only direct callee is `sorted`.
query II
SELECT name, start_line FROM ast_select('test/data/python/callgraph_anon_scope.py',
    'function_definition#uses_anon_lambda::callees')
ORDER BY start_line, name;
----
sorted	42

# (3) NAME-MATCHED, NOT RESOLVED. `speak` is defined three times in
# css_selectors_test.py (Animal line 8, Dog 16, Cat 26) and called once, as
# `animal.speak()` on line 43. `.func#speak` matches all three definitions; the
# single call site is attributed to every one of them by name, and DISTINCT
# collapses the result to the one enclosing function. No resolver decides WHICH
# speak was meant — that is 043 Part C.
query III
SELECT name, type, start_line FROM ast_select('test/data/python/css_selectors_test.py',
    '.func#speak::callers')
ORDER BY start_line;
----
process_animals	function_definition	41

query III
SELECT caller, caller_line, call_line
FROM ast_callers('test/data/python/css_selectors_test.py')
WHERE callee = 'speak'
ORDER BY call_line;
----
process_animals	41	43

# =============================================================================
# :calls / :called-by pseudo-classes on the anonymous-scope fixture
# =============================================================================
# These are already covered on callgraph_direct.py in
# test/sql/ast_select_pseudo_classes.test (lines ~321-362). What is added here is
# the module-level and anonymous-scope behaviour that fixture does not contain.

# 7 call expressions in the file, but only 6 are inside some function scope —
# module_target()'s call has scope.function = NULL.
query II
SELECT
    (SELECT count(*) FROM ast_select('test/data/python/callgraph_anon_scope.py', '.call')),
    (SELECT count(*) FROM ast_select('test/data/python/callgraph_anon_scope.py', '.call:called-by'));
----
7	6

# :called-by(uses_anon_lambda) matches ONLY the `sorted` call. anon_target()'s
# immediate scope is the lambda, not uses_anon_lambda — the #152 direct ruling.
query I
SELECT count(*) FROM ast_select('test/data/python/callgraph_anon_scope.py',
    '.call:called-by(uses_anon_lambda)');
----
1

# :calls is direct and EXISTS-shaped: calls_twice calls twice_target (twice), and
# the selector returns the one matching FUNCTION node, not one row per call.
query I
SELECT count(*) FROM ast_select('test/data/python/callgraph_anon_scope.py',
    'function_definition#calls_twice:calls(twice_target)');
----
1
