# name: test/sql/function_documentation.test
# description: Test discoverability and documentation of sitting_duck functions via duckdb_functions()
# group: [sql]

require sitting_duck

# Test 1: Check scalar functions have descriptions and examples in duckdb_functions()
# =================================================================================

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'parse_ast_list'
  AND description IS NOT NULL
  AND description != ''
  AND len(examples) > 0;
----
true

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'is_name_definition'
  AND description IS NOT NULL
  AND description != ''
  AND len(examples) > 0;
----
true

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'is_syntax_only'
  AND description IS NOT NULL
  AND description != ''
  AND len(examples) > 0;
----
true

query I
SELECT COUNT(*) > 0
FROM duckdb_functions()
WHERE function_name = 'detect_language'
  AND description IS NOT NULL
  AND description != ''
  AND len(examples) > 0;
----
true

