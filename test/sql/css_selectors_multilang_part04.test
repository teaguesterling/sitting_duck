# name: test/sql/css_selectors_multilang_part04.test
# (part 4 of 15 — split from css_selectors_multilang.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Comprehensive CSS selector tests across multiple languages.
# Tests type selectors, ID selectors, class (semantic) selectors,
# combinators (descendant, child, adjacent sibling, general sibling),
# pseudo-classes (:has, :not, :first-child, :last-child, :named, :definition, :scope),
# and ast_select_from (pre-parsed table queries).
#
# Test fixtures:
#   test/data/python/css_selectors_test.py
#   test/data/javascript/css_selectors_test.js
#   test/data/rust/css_selectors_test.rs
#   test/data/go/css_selectors_test.go
#   test/data/rosetta/Lang/*/Factorial/*
#   test/data/rosetta/Lang/*/Abstract-type/*

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# 1. TYPE SELECTORS across languages
# =============================================================================
# Each language uses different AST node types for the same concepts.

# JavaScript: function by name
query I
SELECT name FROM ast_select('test/data/javascript/css_selectors_test.js', 'function_declaration#add');
----
add

# Rust: function by name
query I
SELECT name FROM ast_select('test/data/rust/css_selectors_test.rs', 'function_item#create_point');
----
create_point

# Go: function by name
query I
SELECT name FROM ast_select('test/data/go/css_selectors_test.go', 'function_declaration#NewPoint');
----
NewPoint

# =============================================================================
# 4. DESCENDANT COMBINATOR (A B)
# =============================================================================

# Python: functions inside classes (traverses through block node)
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', 'class_definition function_definition')
ORDER BY name, start_line;
----
__init__
fetch
move
purr
speak
speak
speak

# JavaScript: return_statements inside function_declarations
query I
SELECT type FROM ast_select('test/data/javascript/css_selectors_test.js', 'function_declaration return_statement')
ORDER BY start_line;
----
return_statement
return_statement
return_statement

# Python: return inside if_statement (multiple levels deep)
query I
SELECT type FROM ast_select('test/data/python/css_selectors_test.py', 'if_statement return_statement')
ORDER BY start_line;
----
return_statement
return_statement
return_statement

# Go: return inside if (only Helper's guarded return)
query I
SELECT type FROM ast_select('test/data/go/css_selectors_test.go', 'if_statement return_statement')
ORDER BY start_line;
----
return_statement

# Rust: function_item:has(match_expression) in Rosetta factorial
query I
SELECT name FROM ast_select('test/data/rosetta/Lang/Rust/Factorial/factorial.rs', 'function_item:has(match_expression)')
ORDER BY name;
----
factorial_recursive

# =============================================================================
# 5. CHILD COMBINATOR (A > B)
# =============================================================================
# The child combinator tests direct parent-child AST relationships.
# This is where tree-sitter grammar structure matters: many languages have
# intermediate nodes (block, class_body, declaration_list) between
# the "conceptual parent" and child.
