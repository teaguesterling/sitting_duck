# name: test/sql/ast_unparse_exact.test
# description: byte-exact unparse - write_ast(read_ast(x, source := 'full')) = x (tracker 047 "4b", first half)
# group: [sql]
#
# WHAT THIS GUARDS
# ----------------
# docs/planning/v2-architecture.md ("write_ast laws", settled 2026-10-07) states
# two laws, split by whether the parse retained the source:
#
#   source := 'full'   write_ast(read_ast(x, source := 'full')) = x   BYTE-EXACT
#   anything less      read_ast(write_ast(read_ast(x))) = read_ast(x)  pseudo-inverse
#
# The rules-based macros (ast_unparse / ast_unparse_from / ast_unparse_code /
# ast_unparse_custom) implement the second. They reconstruct source from node
# types and names, never read a position column, and normalise inter-token
# whitespace - which is CONFORMANT below 'full', not a bug, and must not be
# reported as one (#89). tracker 047 recorded, as a measured result, that
# byte-identity therefore held for NONE of the 26 corpus languages.
#
# ast_unparse_exact* implements the first, by SPLICING the original bytes at
# [start_byte, end_byte) rather than reconstructing anything:
#
#     for each leaf (descendant_count = 0), in byte order:
#         emit bytes [previous leaf's end_byte, this leaf's start_byte)   GAP
#         emit bytes [this leaf's start_byte,   this leaf's end_byte)     LEAF
#     emit bytes [last leaf's end_byte, EOF)                             TAIL
#
# Section 2 below asserts the law for all 26 tree-sitter languages. Section 3
# is the part that makes those 26 assertions worth anything: an equality
# against the file is ALSO satisfied by a whole-file slice that ignores the
# tree entirely, so sections 3 and 4 prove the pieces are load-bearing and
# that the comparison can fail.
#
# The oracle is the FILE ITSELF, read with read_blob() and compared as a BLOB.
# Nothing derived from the parse takes part in the comparison - not `peek`, not
# line/column, not the byte offsets - so a wrong offset cannot hide behind it.
# This is strictly stronger than scripts/verify_byte_offsets.sh pass 1, which
# compares a slice against `peek` (derived from the same offsets).
#
# The corpus sweep with per-language numbers lives in
# scripts/verify_unparse_byte_exact.sh; per-node hex slicing is too slow to put
# a whole corpus in the suite. Re-run it after a grammar bump.
#
# NOT COVERED
# -----------
# language 'duckdb' (the native, non-tree-sitter parser), for two reasons that
# both outlive #197. PR #205 fixed that adapter's constant-zero children_count /
# sibling_index / depth, so its tree structure is now correct - but re-measured
# against #205 it still reports start_byte = end_byte = 0 (and an empty
# file_path) for every node, AND its tree is an AST rather than a CST: 15 nodes
# for an 84-byte, 7-clause SQL file, with no node for any keyword, punctuation
# or comment and ORDER BY / LIMIT absent entirely. No leaf frontier over such a
# tree could tile the text, so byte offsets alone would not make it serveable.
# ast_unparse_exact ERRORS on it - asserted in section 5 - rather than emitting
# anything.
#
# PLATFORM NOTE. Nothing here may pin a literal forward-slash path against a
# `file_path` column: DuckDB's globber returns NATIVE separators, so on Windows
# a table built from read_ast('test/data/*') carries `test\data\x.py`. Every
# comparison against a path column goes through replace(..., '\', '/') - and
# section 6 has a test that deliberately feeds the macro Windows-style
# separators to prove the matching is separator-insensitive. (This is not
# hypothetical: it is the one CI failure the first version of this file
# produced, on Windows only, and only the path half of that row - the
# byte-identity half passed.)

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# 1. The law, in one statement
# =============================================================================
# ast_unparse_exact(path) parses with source := 'full' and re-reads the bytes
# in the same statement, which is the narrowest staleness window available.

query I
SELECT encode(u.source) = b.content
FROM ast_unparse_exact('test/data/unparse_leaf_text/sample.py') u,
     read_blob('test/data/unparse_leaf_text/sample.py') b;
----
true

# The same thing the long way round: a node table plus the bytes.
statement ok
CREATE TABLE py_full AS
SELECT * FROM read_ast('test/data/unparse_leaf_text/sample.py', source := 'full', peek := 'none');

query I
SELECT encode(u.source) = b.content
FROM ast_unparse_exact_from('py_full', 'test/data/unparse_leaf_text/sample.py') u,
     read_blob('test/data/unparse_leaf_text/sample.py') b;
----
true

# And for an in-memory parse, where the "file" is the string argument itself.
query I
SELECT source = E'def f(a,b):\n  return a+b  # trailing comment\n'
FROM ast_unparse_exact_code(E'def f(a,b):\n  return a+b  # trailing comment\n', 'python');
----
true

