/**
 * @file dart_unparse.def
 * @brief Dart unparse formatting rules
 */

DEF_UNPARSE_INDENT("block", 1)
DEF_UNPARSE_INDENT("class_body", 1)
DEF_UNPARSE_INDENT("enum_body", 1)
DEF_UNPARSE_INDENT("extension_body", 1)
DEF_UNPARSE_INDENT("function_body", 1)
DEF_UNPARSE_LINES_BEFORE("class_definition", 1)
DEF_UNPARSE_LINES_BEFORE("enum_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("method_signature", 1)
