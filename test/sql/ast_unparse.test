    FROM parse_ast(E'int max(int a, int b) {\n    if (a > b) {\n        return a;\n    }\n    return b;\n}\n', 'c')
),
unp AS (
    SELECT source FROM ast_unparse_code(E'int max(int a, int b) {\n    if (a > b) {\n        return a;\n    }\n    return b;\n}\n', 'c')
),
reparsed AS (
    SELECT string_agg(type, ' > ' ORDER BY node_id) AS sig
    FROM parse_ast_list_table((SELECT source FROM unp), 'c')
)
SELECT (SELECT sig FROM orig) = (SELECT sig FROM reparsed);
----
true

