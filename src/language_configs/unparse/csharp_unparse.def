/**
 * @file csharp_unparse.def
 * @brief C# unparse formatting rules
 */

DEF_UNPARSE_INDENT("block", 1)
DEF_UNPARSE_INDENT("declaration_list", 1)
DEF_UNPARSE_INDENT("accessor_list", 1)
DEF_UNPARSE_INDENT("switch_body", 1)
DEF_UNPARSE_INDENT("enum_member_declaration_list", 1)
DEF_UNPARSE_INDENT("anonymous_object_creation_expression", 1)
DEF_UNPARSE_LINES_BEFORE("class_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("struct_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("interface_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("enum_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("method_declaration", 1)
DEF_UNPARSE_LINES_BEFORE("namespace_declaration", 1)
