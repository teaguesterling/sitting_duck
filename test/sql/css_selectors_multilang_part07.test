# name: test/sql/css_selectors_multilang_part07.test
# (part 7 of 15 — split from css_selectors_multilang.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Comprehensive CSS selector tests across multiple languages.
# Tests type selectors, ID selectors, class (semantic) selectors,
# combinators (descendant, child, adjacent sibling, general sibling),
# pseudo-classes (:has, :not, :first-child, :last-child, :named, :definition, :scope),
# and ast_select_from (pre-parsed table queries).
#
# Test fixtures:
#   test/data/python/css_selectors_test.py
#   test/data/javascript/css_selectors_test.js
#   test/data/rust/css_selectors_test.rs
#   test/data/go/css_selectors_test.go
#   test/data/rosetta/Lang/*/Factorial/*
#   test/data/rosetta/Lang/*/Abstract-type/*

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# 1. TYPE SELECTORS across languages
# =============================================================================
# Each language uses different AST node types for the same concepts.

# Python: functions containing return_statement
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', 'function_definition:has(return_statement)')
ORDER BY name, start_line;
----
fetch
make_animal
move
speak
speak
speak

# Python: classes containing a function named speak (all have it)
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', 'class_definition:has(function_definition#speak)')
ORDER BY name;
----
Animal
Cat
Dog

# JavaScript: classes with a constructor
query I
SELECT name FROM ast_select('test/data/javascript/css_selectors_test.js', 'class_declaration:has(method_definition#constructor)')
ORDER BY name;
----
Circle
Shape
Square

# JavaScript: functions containing try_statement
query I
SELECT name FROM ast_select('test/data/javascript/css_selectors_test.js', 'function_declaration:has(try_statement)')
ORDER BY name;
----
fetchShape

# JavaScript: functions containing while_statement (Rosetta factorial)
query I
SELECT name FROM ast_select('test/data/rosetta/Lang/JavaScript/Factorial/factorial-1.js', 'function_declaration:has(while_statement)')
ORDER BY name;
----
factorial

# Python: functions containing if_statement
query I
SELECT name FROM ast_select('test/data/python/css_selectors_test.py', 'function_definition:has(if_statement)')
ORDER BY name;
----
fetch
make_animal
process_animals

# Rosetta: Go factorial functions containing calls (type-based)
# factorial has recursive call; main calls factorial and Println
query I
SELECT name FROM ast_select('test/data/rosetta/Lang/Go/Factorial/factorial-1.go', 'function_declaration:has(call_expression)')
ORDER BY name;
----
factorial
main

# Rosetta: Python factorial function containing range call
query I
SELECT name FROM ast_select('test/data/rosetta/Lang/Python/Factorial/factorial-2.py', 'function_definition:has(call)')
ORDER BY name;
----
factorial

