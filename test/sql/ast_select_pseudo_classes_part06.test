# name: test/sql/ast_select_pseudo_classes_part06.test
# (part 6 of 19 — split from ast_select_pseudo_classes.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Test ast_select pseudo-classes: positional, structural, scope, ordering

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# Standard CSS positional pseudo-classes
# =============================================================================

# .class shape and its aliases resolve the same as the keyword (.func == .fn)
# (decomposed from one 8-call assertion into 4x 2-call to fit the v2.0 per-file CI budget; #160)
query I
SELECT (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.func)'))
     = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.fn)'));
----
true

# .class shape and its aliases resolve the same as the keyword (.cls == .class)
# (decomposed from one 8-call assertion into 4x 2-call to fit the v2.0 per-file CI budget; #160)
query I
SELECT (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.cls)'))
     = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.class)'));
----
true
