# name: test/sql/macro_from_parity_relational.test
# description: M2 stage 3 -- the five relational _from variants agree with their path-taking twins
# group: [sitting_duck]
#
# WHAT THIS GUARDS
# ----------------
# ast_has / ast_not_has / ast_inside / ast_precedes / ast_follows each gained a
# `_from` variant that reads an already-parsed AST table with query_table()
# instead of calling read_ast() itself. The twins were then rewritten as thin
# wrappers that parse and delegate, following ast_select / ast_select_from.
#
# THE EXCEPT ALL PAIRS BELOW COMPARED TWO INDEPENDENT BODIES ONCE: on the build
# where the `_from` macros existed and the twins did NOT yet delegate to them.
# From the wrapper rewrite onwards both sides evaluate the same body, so a
# defect INSIDE a `_from` body moves both sides at once and the pairs cannot see
# it. What they do still see is a defect in the WRAPPER, which is the only part
# that differs between the two sides: an argument forwarded to the wrong
# parameter, a changed column list (which fails to bind against the other side),
# or a row duplicated or dropped.
#
# EXCEPT ALL, not EXCEPT. Set semantics cannot see multiplicity at all --
# MEASURED: `(SELECT 1 UNION ALL SELECT 1) EXCEPT (SELECT 1)` is empty in both
# directions, while EXCEPT ALL returns the extra row. A wrapper that doubled
# every row would pass a plain EXCEPT in both directions.
#
# THE PINNED COUNTS AND DIGESTS ARE WHAT CATCH A DEFECT INSIDE A `_from` BODY.
# Every pinned value in this file was MEASURED from the path-taking twins as
# they stood at commit 4d4252e, BEFORE any of this task's changes -- that is,
# from the implementation this task replaces, not from the one it introduces.
# Sections 1-6 digest node_id, which cannot see a column change; section 7
# digests the whole row, over two files. A pin that moves is a parity failure to
# investigate, never a value to update.
#
# The argument tuples are measured non-empty, and two obvious choices are not:
# 'class_definition'/'function_definition' returns 0 rows for ast_not_has and
# for ast_precedes, because every class in sample_app.py contains a function
# and no function precedes a class. A zero baseline makes an EXCEPT vacuous.

require sitting_duck

# The pre-parsed table every `_from` call below reads. Default extraction
# options, exactly as the twins' own read_ast() call uses them, or the EXCEPT
# would differ in the peek column rather than in the predicate.
statement ok
CREATE TABLE t AS SELECT * FROM read_ast('test/data/python/sample_app.py');

# =============================================================================
# 1. ast_has
# =============================================================================

# The baseline must not be empty, or EXCEPT proves nothing.
query I
SELECT count(*) > 0 FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition');
----
true

query I
SELECT count(*) FROM (
  SELECT * FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition')
  EXCEPT ALL SELECT * FROM ast_has_from('t', 'class_definition', 'function_definition')
);
----
0

# The other direction, which catches a `_from` form returning extra rows.
query I
SELECT count(*) FROM (
  SELECT * FROM ast_has_from('t', 'class_definition', 'function_definition')
  EXCEPT ALL SELECT * FROM ast_has('test/data/python/sample_app.py', 'class_definition', 'function_definition')
);
----
0

# Pinned: absolute row count and node_id digest, measured pre-change.
query II
SELECT count(*), md5(string_agg(node_id::VARCHAR, ',' ORDER BY node_id))
FROM ast_has_from('t', 'class_definition', 'function_definition');
----
3	a32099295b23cba7e6cd1c300eca0d65

