# name: test/sql/ast_select_pseudo_classes_part05.test
# (part 5 of 19 — split from ast_select_pseudo_classes.test for the v2.0 CI per-file 600s timeout budget, #160)
# group: [sql]

# Test ast_select pseudo-classes: positional, structural, scope, ordering

require sitting_duck

statement ok
LOAD sitting_duck;

# =============================================================================
# Standard CSS positional pseudo-classes
# =============================================================================

# :scope(<tree-sitter type>) — a scope of exactly that node type
query I
SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(function_definition)');
----
6

# .class shape and its aliases resolve the same as the keyword (.fn == function)
# (decomposed from one 8-call assertion into 4x 2-call to fit the v2.0 per-file CI budget; #160)
query I
SELECT (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(.fn)'))
     = (SELECT COUNT(*) FROM ast_select('test/data/python/qualified_names.py', ':scope(function)'));
----
true
